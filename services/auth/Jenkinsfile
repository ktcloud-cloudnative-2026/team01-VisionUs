// auth 서비스 파이프라인 (실습 5 기준, 우리 저장소에 맞게 수정)
// Jenkins 작업 이름: auth / Script Path: services/auth/Jenkinsfile
// 다른 서비스는 이 파일을 복사해 auth → 내 서비스 이름으로 바꾼다
pipeline {
  agent any
  options { disableConcurrentBuilds() }
  triggers { pollSCM('H/2 * * * *') }   // 2분마다 GitHub 확인 (t1-ci는 내부망이라 웹훅 대신)

  environment {
    GH       = credentials('github')    // GH_USR(아이디), GH_PSW(토큰)
    ORG_REPO = 'ktcloud-cloudnative-2026/team01-VisionUs'
    IMAGE    = 'ghcr.io/ktcloud-cloudnative-2026/team01-visionus/auth'
  }

  stages {
    stage('시작 조건') {
      // auth이 바뀌지 않은 커밋(배포 PR 머지 포함)이면 아무것도 하지 않는다
      when { not { anyOf { changeset 'services/auth/**'; triggeredBy 'UserIdCause' } } }
      steps {
        script { currentBuild.result = 'NOT_BUILT'; currentBuild.description = 'auth 변경 없음' }
      }
    }
    stage('준비') {
      when { anyOf { changeset 'services/auth/**'; triggeredBy 'UserIdCause' } }
      steps {
        script { env.TAG = 'sha-' + sh(script: 'git rev-parse --short=7 HEAD', returnStdout: true).trim() }
        echo "이미지: ${env.IMAGE}:${env.TAG}"
      }
    }
    stage('테스트') {
      when { anyOf { changeset 'services/auth/**'; triggeredBy 'UserIdCause' } }
      steps {
        sh 'docker run --rm -u "$(id -u):$(id -g)" -e HOME=/tmp -v "$WORKSPACE/services/auth":/src -w /src node:24-alpine sh -c "npm ci && npm test"'
      }
    }
    stage('빌드') {
      when { anyOf { changeset 'services/auth/**'; triggeredBy 'UserIdCause' } }
      steps { sh 'docker build -t "$IMAGE:$TAG" -t "$IMAGE:latest" services/auth' }
    }
    stage('스캔') {
      when { anyOf { changeset 'services/auth/**'; triggeredBy 'UserIdCause' } }
      steps {
        sh 'trivy image --cache-dir "$JENKINS_HOME/.trivy" --exit-code 1 --severity CRITICAL --ignore-unfixed "$IMAGE:$TAG"'
      }
    }
    stage('올리기') {
      when { anyOf { changeset 'services/auth/**'; triggeredBy 'UserIdCause' } }
      steps {
        sh 'echo "$GH_PSW" | docker login ghcr.io -u "$GH_USR" --password-stdin'
        sh 'docker push "$IMAGE:$TAG" && docker push "$IMAGE:latest"'
      }
    }
    stage('배포 PR') {
      // main은 보호되어 있어 직접 push하지 않고, 태그를 바꾼 브랜치를 올려 PR을 만든다
      when { anyOf { changeset 'services/auth/**'; triggeredBy 'UserIdCause' } }
      steps {
        sh '''
          set -e
          BRANCH="deploy/dev-auth-$TAG"
          git checkout -B "$BRANCH" origin/main
          (cd deploy/overlays/dev && kustomize edit set image "$IMAGE:$TAG")
          if git diff --quiet; then echo "바뀐 것 없음"; exit 0; fi
          git -c user.name="jenkins" -c user.email="jenkins@team01.local" commit -am "deploy(dev): auth $TAG"
          git push "https://$GH_USR:$GH_PSW@github.com/$ORG_REPO.git" "HEAD:refs/heads/$BRANCH"
          cat > pr.json <<EOF
{"title":"deploy(dev): auth $TAG","head":"$BRANCH","base":"main","body":"Jenkins 빌드 #$BUILD_NUMBER 가 만든 dev 배포 PR입니다. 머지하면 Argo CD가 dev에 배포합니다."}
EOF
          if curl -fsS -X POST -H "Authorization: Bearer $GH_PSW" -H "Accept: application/vnd.github+json" \
               "https://api.github.com/repos/$ORG_REPO/pulls" -d @pr.json -o pr-res.json; then
            grep -o '"html_url": *"[^"]*/pull/[0-9]*"' pr-res.json | head -1
          else
            echo "PR 자동 생성 실패. 이 링크로 PR을 만드세요: https://github.com/$ORG_REPO/compare/main...$BRANCH?expand=1"
          fi
        '''
      }
    }
  }
  post {
    always { sh 'docker logout ghcr.io || true; rm -f pr.json pr-res.json' }
  }
}
